# Everything below is yours alone: never committed, and never touched by ./update.sh.
# Local answers files: they hold your own paths and preferences. The installer saves
# your answers to answers.env and reuses them on every re-run.
answers.env
*.answers.env
answers.local.*
# A folder for any other file of your own you want to keep next to the clone.
local/

# Secrets and machine-local config. The installer never writes these into the repo,
# but keep them out of git if you create one here by hand.
.env
.env.*
*.local.json
.claude/settings.local.json

# The privacy denylist holds the private terms the scan looks for; never commit it.
.privacy-denylist.txt

# Generated output.
generated/
*.bak-*
node_modules/
.DS_Store
