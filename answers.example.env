# Example answers for unattended runs:
#   cp answers.example.env answers.env     # answers.env is gitignored
#   ./install.sh --yes --answers answers.env
# Any key left out falls back to its default. Secrets are NEVER read from this
# file: export them instead (CLICKUP_TOKEN, CONTEXT7_API_KEY) or omit them and
# sign in later. Lists are comma-separated; yes/no for confirmations.

# Modules: "default", "all", or names (see ./install.sh --list)
MODULES=default

# core
CORE_GH_LOGIN=no

# claude-code: keep | opus | sonnet | haiku ; keep | low | medium | high ; keep | dark | light
CLAUDE_MODEL=keep
CLAUDE_EFFORT=keep
CLAUDE_THEME=keep
# keep | hide | show
CLAUDE_THINKING_SUMMARIES=keep
# ccstatusline | gauges | none
CLAUDE_STATUSLINE=ccstatusline
# model=level pairs, levels low | medium | high | xhigh (empty keeps yours)
CLAUDE_MODEL_EFFORTS=
# keep | on | off
CLAUDE_REMOTE_CONTROL=keep
# keep | fullscreen | default
CLAUDE_TUI=keep
# 100000 to 1000000 tokens (empty keeps yours)
CLAUDE_AUTOCOMPACT_WINDOW=
CLAUDE_PLUGINS=diagram-design
CLAUDE_CONTEXT_REMINDER=yes
CLAUDE_CONTEXT_REMINDER_TOKENS=150000
CLAUDE_COMPACT_REMINDER=yes

# agent-clis (optional extras: notion-axi, gws-axi, herdr, codex, agy, composio, mermaid-ascii, pixel-agents)
AGENT_CLIS=gh-axi,chrome-devtools-axi,lavish-axi,tasks-axi,quota-axi,ctx7,no-mistakes,treehouse
AXI_HOOKS=claude
CTX7_SETUP=no
HERDR_CLAUDE_INTEGRATION=yes
LAVISH_NO_OPEN=yes
RESEARCH_BROWSER=yes

# mcp-servers: context7, chrome-devtools, ticktick (empty for none)
MCP_SERVERS=

# skills (optional extras: no-mistakes, composio-cli)
SKILLS=kun,grill-me,grilling,teach,to-questionnaire,find-docs

# backpass (opt-in; run with MODULES including backpass). Projects are comma-separated folders.
BACKPASS_PROJECTS=
BACKPASS_DENYLIST=~/.config/ai-workstation-setup/backpass/denylist.txt
# claude | codex
BACKPASS_AGENT=claude
BACKPASS_MODEL=claude-sonnet-5
# none | 30m
BACKPASS_SCHEDULE=none

# firstmate (Linux, macOS, WSL)
FIRSTMATE_DIR=~/firstmate
FIRSTMATE_BACKEND=tmux
FIRSTMATE_CREW_HARNESS=default
FIRSTMATE_SECONDMATE_HARNESS=default
FIRSTMATE_PERMISSION_MODE=bypass
FIRSTMATE_BACKLOG=tasks-axi
FIRSTMATE_DISPATCH=starter
FIRSTMATE_DISPATCH_HARNESS=claude
FIRSTMATE_WATCH_UPDATES=yes

# preferences (see docs/working-preferences.md)
# targets: claude, firstmate
PREFS_TARGETS=claude,firstmate
# language and tone
PREFS_PLAIN_LANGUAGE=yes
PREFS_NO_NARRATION=yes
PREFS_NO_EM_DASHES=yes
PREFS_OUTWARD_AS_USER=yes
PREFS_NATURAL_TRANSLATION=yes
PREFS_WRITING_PRINCIPLES=yes
PREFS_ONE_DESIGN_SYSTEM=no
PREFS_COPY_SECOND_OPINION=no
PREFS_CALM_WORD=calm
# reporting and status: board | brief | none
PREFS_STATUS=board
PREFS_HONEST_NUMBERS=yes
PREFS_LINK_DELIVERABLES=yes
PREFS_DAILY_CHECK=yes
PREFS_STALE_DAYS=2
PREFS_AWAY_MODE=yes
# decisions: cards | tool | chat
PREFS_DECISIONS=cards
PREFS_YES_NO_IN_CHAT=yes
PREFS_PREVIEW_BEFORE_BUILD=yes
PREFS_CHECK_ANSWERS_FIRST=yes
PREFS_ASK_BEFORE_CLOSING=yes
# act | ask
PREFS_AUTONOMY=act
# a file path, or empty for none
PREFS_DECISIONS_LOG=
PREFS_GRILL_ON_GAPS=yes
# review pages (the first two apply with PREFS_DECISIONS=cards)
PREFS_PAGE_SIDE_BY_SIDE=yes
PREFS_PAGE_FLIP_PREVIEWS=yes
PREFS_PAGE_MINIMAL_TEXT=yes
PREFS_PAGE_WIDE_HEADER=yes
PREFS_PAGE_CHECK_BEFORE_SEND=yes
PREFS_PAGE_FIRST=yes
PREFS_FLEET_WORKFLOW=yes
# ideas and priorities
PREFS_CAPTURE_IDEAS=yes
PREFS_RESEQUENCE=yes
PREFS_ORIENT=yes
PREFS_FINISH_FIRST=yes
# AI and model use: economical | balanced | none
PREFS_MODEL_ROUTING=economical
PREFS_QUOTA=yes
# a secondary agent CLI such as agy, or empty for none
PREFS_DELEGATE_RETRIEVAL=
# research: separate | none
PREFS_RESEARCH_BROWSER=separate
PREFS_SOURCE_QUALITY=yes
PREFS_FINDINGS_TO_CHANGE=yes
PREFS_VERIFY_USER_CLAIMS=yes
# safety: explicit | green
PREFS_MERGE=explicit
PREFS_VERIFY_CAUSE=yes
PREFS_PAUSE_WORD=pause
PREFS_STOP_DIGGING=yes

# second-brain: VAULT_PILLARS is an example set of life areas, edit it to match your own
VAULT_PATH=~/second-brain
VAULT_PILLARS=professional,personal,growth,health,finance
VAULT_RAW_DIR=~/raw-sources
VAULT_LANGS=en
VAULT_SCRIPTS=yes
VAULT_GIT=yes
VAULT_AGENT_ACCESS=yes
VAULT_APP=no

# extras (optional: docling, openwhispr; empty for none)
EXTRAS=

# clickup
CLICKUP_SKILL=yes
CLICKUP_HOOK=yes
CLICKUP_DEFAULT_LIST=

# daily-sync (opt-in; run with MODULES including daily-sync). Folders are comma-separated.
DAILY_SYNC_TIME=07:30
# auto | none
DAILY_SYNC_SCHEDULE=auto
DAILY_SYNC_PULL=
DAILY_SYNC_WATCH=
DAILY_SYNC_VAULT=yes
DAILY_SYNC_VAULT_PATH=~/second-brain
DAILY_SYNC_RAW_DIR=~/raw-sources
DAILY_SYNC_INGEST_LIMIT=3
# tool-updates, clickup, ticktick (empty for none)
DAILY_SYNC_SURFACES=tool-updates
DAILY_SYNC_FIRSTMATE_DIR=~/firstmate
DAILY_SYNC_CLICKUP_WORKSPACE=
DAILY_SYNC_CLICKUP_SPACE=
DAILY_SYNC_CLICKUP_LISTS=
DAILY_SYNC_TICKTICK_LISTS=Professional,Personal,Growth,Health,Finance
DAILY_SYNC_TICKTICK_COMMAND=ticktick --format json projects list
# a command that reads the report on stdin, or empty for the report file only
DAILY_SYNC_NOTIFY=
# a command for one short model call per new drift item, or empty to never call a model
DAILY_SYNC_MODEL=claude -p --model haiku --tools "" --strict-mcp-config --no-session-persistence --setting-sources "" --system-prompt "Answer in at most three short lines of plain text, from the evidence given only."
DAILY_SYNC_SESSION_HOOK=yes

# voice-mode (opt-in; run with MODULES including voice-mode). Keys go in
# ~/.config/ai-workstation-setup/voice/.env, never here. openai | gemini
VOICE_PROVIDER=openai
# files and folders it may read (comma-separated), read-only
VOICE_SOURCES=
VOICE_VAULT_SEARCH=yes
# command that queues work; the request is added as its last argument (empty: none)
VOICE_QUEUE_COMMAND=
VOICE_ACTIONS=yes
# env file holding OPENROUTER_API_KEY for the decision model (empty: the environment)
VOICE_ACTIONS_KEY_FILE=
VOICE_DOCUMENTS=~/Documents
# a text file with your own persona (empty: a neutral default)
VOICE_PERSONA_FILE=
VOICE_HOTKEY=Meta+Shift+Space

# terminal
TERMINAL_INSTALL_WEZTERM=yes
TERMINAL_WRITE_CONFIG=yes
TERMINAL_COLOR_SCHEME=Tokyo Night
TERMINAL_FONT_SIZE=11.5
TERMINAL_OPACITY=0.88
TERMINAL_WSL_DEFAULT=no
